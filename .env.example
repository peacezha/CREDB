# CREDB backend environment configuration
# Copy this file to ".env" and fill in real values. NEVER commit ".env" to git.

# --- Database (remote MySQL) ---
# MySQL host
DB_HOST=211.69.142.213
# MySQL port
DB_PORT=3306
# MySQL user
DB_USER=ATAC_web
# MySQL password — REQUIRED, no default. The server exits on startup if missing.
DB_PASSWORD=
# Database name
DB_NAME=atac_web

# --- HTTP server ---
# Port the backend listens on
PORT=8001
# Comma-separated list of allowed CORS origins (no spaces).
# Requests whose Origin header is not in this list get no Access-Control-Allow-Origin header.
CORS_ORIGINS=http://localhost:3000
